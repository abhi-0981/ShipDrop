# AdminPanel Backend Local Development Environment (.env or .env.development)
NODE_ENV=development
PORT=5001

# Database (Local MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=shipdrop

# Auth Secret
JWT_SECRET=your_admin_jwt_secret_key

# Allowed Frontend Origins (comma-separated)
FRONTEND_URL=http://localhost:5174,https://admin.parceldrop.in,https://parceldrop.in

# Courier Partner (Delhivery)
DELHIVERY_API_TOKEN=your_delhivery_api_token
DELHIVERY_API_BASE_URL=https://track.delhivery.com
