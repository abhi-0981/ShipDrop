# Server Local Development Environment (.env or .env.development)
NODE_ENV=development
PORT=5000

# Database (Local MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=shipdrop

# Auth Secret
JWT_SECRET=your_jwt_secret_key

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_TRtn0P51gGU0X7
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Courier Partner (Delhivery)
DELHIVERY_API_TOKEN=your_delhivery_api_token
DELHIVERY_API_BASE_URL=https://track.delhivery.com

# Allowed Frontend Origins (comma-separated)
FRONTEND_URL=http://localhost:5173,https://parceldrop.netlify.app,https://parceldrop.in
